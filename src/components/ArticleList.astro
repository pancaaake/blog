---
import type { CollectionEntry } from 'astro:content';
import { articleUrl, formatDate, type ArticleCollection } from '../lib/posts';

interface Props {
  collection: ArticleCollection;
  posts: CollectionEntry<ArticleCollection>[];
}

const { collection, posts } = Astro.props;
---

{posts.length === 0 && <p class="empty">まだ記事がありません。</p>}
<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <a href={articleUrl(collection, post.id)}>{post.data.title}</a>
        {post.data.draft && <span class="badge">下書き</span>}
        {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
        {post.data.description && <p>{post.data.description}</p>}
      </li>
    ))
  }
</ul>
